        ]
      },
      "mitre_attack": [
        {
          "tactic_id": "TA0002",
          "tactic_name": "Execution",
          "technique_id": "T1059",
          "technique_name": "Command and Scripting Interpreter"
        }
      ],
      "false_positives": [
        "Legitimate browser helpers, PDF automation, and developer tools."
      ],
      "investigation_steps": [
        "Verify parent and child executable paths.",
