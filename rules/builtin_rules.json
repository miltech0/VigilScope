      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
          "process_create_time",
          "remote_ip",
          "remote_port"
        ]
      },
      "mitre_attack": [],
      "false_positives": [
        "Legitimate installers and portable applications."
      ],
      "investigation_steps": [
        "Verify the file source and remote endpoint."
      ],
      "tags": [
        "temp",
        "network"
      ],
      "version": "1.0",
      "title_key": "rules.PROC-008.title",
      "description_key": "rules.PROC-008.description",
      "category_key": "rules.PROC-008.category"
    },
