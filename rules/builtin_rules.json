    {
      "id": "NET-101",
      "title": "Many unique public endpoints in a short period",
      "description": "The same process connected to at least 20 unique public endpoints within 60 seconds.",
      "enabled": true,
      "severity": "medium",
      "category": "Network Volume",
      "event_types": [
        "remote_endpoint_new",
        "remote_endpoint_reappeared"
      ],
      "conditions": {
        "field": "address_scope",
        "operator": "equals",
        "value": "public"
      },
      "correlation": {
        "type": "distinct_count",
        "within_seconds": 60,
        "minimum_count": 20,
        "distinct_field": "remote_ip"
      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
          "process_create_time"
        ],
        "bucket_seconds": 60
      },
      "mitre_attack": [],
      "false_positives": [
        "Browsers, game clients, updaters, and applications using CDNs."
      ],
      "investigation_steps": [
        "Compare the endpoint list with the application's expected network behavior."
      ],
      "tags": [
        "network",
        "volume"
      ],
      "version": "1.0",
      "title_key": "rules.NET-101.title",
      "description_key": "rules.NET-101.description",
      "category_key": "rules.NET-101.category"
    },
    {
      "id": "NET-102",
      "title": "New process started listening on all interfaces",
      "description": "A new process started listening on 0.0.0.0 or :: within 30 seconds.",
      "enabled": true,
      "severity": "medium",
      "category": "Listener Correlation",
      "event_types": [
        "process_started",
        "listener_started"
      ],
      "conditions": {},
      "correlation": {
        "type": "sequence",
        "within_seconds": 30,
        "ordered": true,
        "sequence": [
          {
            "event_type": "process_started"
          },
          {
            "event_type": "listener_started",
            "conditions": {
              "field": "local_ip",
              "operator": "in",
              "value": [
                "0.0.0.0",
                "::"
              ]
            }
          }
        ]
      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
          "process_create_time",
          "local_port"
        ]
      },
      "mitre_attack": [],
      "false_positives": [
        "Legitimate local servers and development tools."
      ],
      "investigation_steps": [
        "Observe and verify the port, executable path, and firewall scope."
      ],
      "tags": [
        "listener",
        "all_interfaces"
      ],
      "version": "1.0",
      "title_key": "rules.NET-102.title",
      "description_key": "rules.NET-102.description",
      "category_key": "rules.NET-102.category"
    },
    {
      "id": "NET-103",
      "title": "New listening port not marked as expected",
      "description": "A listening port not explicitly marked as expected by the user opened.",
      "enabled": true,
      "severity": "low",
      "category": "Listener Baseline",
      "event_types": [
        "listener_started"
      ],
      "conditions": {
        "field": "additional_data.is_expected",
        "operator": "equals",
        "value": false
      },
      "group_by": [
        "protocol",
        "local_ip",
        "local_port",
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "protocol",
          "local_ip",
          "local_port",
          "pid",
          "process_create_time"
        ]
      },
      "mitre_attack": [],
      "false_positives": [
        "Newly installed or first-used legitimate server applications."
      ],
      "investigation_steps": [
        "Verify the process opening the port and its listening scope."
      ],
      "tags": [
        "listener",
        "baseline"
      ],
      "version": "1.0",
      "title_key": "rules.NET-103.title",
      "description_key": "rules.NET-103.description",
      "category_key": "rules.NET-103.category"
    },
    {
      "id": "NET-104",
      "title": "Unexpected high-numbered listening port",
      "description": "A process not marked as expected started listening on port 49152 or higher.",
      "enabled": true,
      "severity": "low",
      "category": "Listener Baseline",
      "event_types": [
        "listener_started"
      ],
      "conditions": {
        "all": [
          {
            "field": "local_port",
            "operator": "greater_or_equal",
            "value": 49152
          },
          {
            "field": "additional_data.is_expected",
            "operator": "equals",
            "value": false
          }
        ]
      },
      "group_by": [
        "protocol",
        "local_ip",
        "local_port",
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "protocol",
          "local_ip",
          "local_port",
          "pid",
          "process_create_time"
        ]
      },
      "mitre_attack": [],
      "false_positives": [
        "Many legitimate applications use dynamic high-numbered ports."
      ],
      "investigation_steps": [
        "Verify the process network role and whether the port is expected."
      ],
      "tags": [
        "listener",
        "high_port"
      ],
      "version": "1.0",
      "title_key": "rules.NET-104.title",
      "description_key": "rules.NET-104.description",
      "category_key": "rules.NET-104.category"
    },
