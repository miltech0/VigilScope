    {
      "id": "PROC-003",
      "title": "Process launched from a temporary or Downloads folder",
      "description": "An executable was launched from a temporary directory or the user's Downloads folder.",
      "enabled": true,
      "severity": "low",
      "category": "Execution Location",
      "event_types": [
        "process_started"
      ],
      "conditions": {
        "any": [
          {
            "field": "executable_path",
            "operator": "contains",
            "value": "\\AppData\\Local\\Temp\\"
          },
          {
            "field": "executable_path",
            "operator": "contains",
            "value": "\\Windows\\Temp\\"
          },
          {
            "field": "executable_path",
            "operator": "contains",
            "value": "\\Downloads\\"
          }
        ]
      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
          "process_create_time"
        ]
      },
      "mitre_attack": [],
      "false_positives": [
        "Installers and legitimate portable applications downloaded by the user."
      ],
      "investigation_steps": [
        "Verify the file source and signature with operating-system tools."
      ],
      "tags": [
        "process",
        "temp",
        "downloads"
      ],
      "version": "1.0",
      "title_key": "rules.PROC-003.title",
      "description_key": "rules.PROC-003.description",
      "category_key": "rules.PROC-003.category"
    },
    {
      "id": "PROC-004",
      "title": "PowerShell encoded command indicator",
      "description": "A common argument associated with encoded PowerShell commands was observed.",
      "enabled": true,
      "severity": "medium",
      "category": "Command Interpreter",
      "event_types": [
        "process_started"
      ],
      "conditions": {
        "all": [
          {
            "field": "process_name",
            "operator": "in",
            "value": [
              "powershell.exe",
              "pwsh.exe"
            ]
          },
          {
            "any": [
              {
                "field": "masked_command_line",
                "operator": "regex",
                "value": "(^|\\s)-(enc|encodedcommand)(\\s|:|$)"
              },
              {
                "field": "masked_command_line",
                "operator": "regex",
                "value": "(^|\\s)/enc(\\s|:|$)"
              }
            ]
          }
        ]
      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
          "process_create_time"
        ]
      },
      "mitre_attack": [
        {
          "tactic_id": "TA0002",
          "tactic_name": "Execution",
          "technique_id": "T1059.001",
          "technique_name": "PowerShell"
        }
      ],
      "false_positives": [
        "Legitimate administration and software-deployment scripts may use encoded commands."
      ],
      "investigation_steps": [
        "Verify the command source and parent process.",
        "Review related network and listener events."
      ],
      "tags": [
        "powershell",
        "encoded"
      ],
      "version": "1.0",
      "title_key": "rules.PROC-004.title",
      "description_key": "rules.PROC-004.description",
      "category_key": "rules.PROC-004.category"
    },
    {
      "id": "PROC-005",
      "title": "Command interpreter launched by an unusual parent",
      "description": "A command or script interpreter was launched outside the common expected parent list.",
      "enabled": true,
      "severity": "low",
      "category": "Process Chain",
      "event_types": [
        "process_started"
      ],
      "conditions": {
        "all": [
          {
            "field": "process_name",
            "operator": "in",
            "value": [
              "powershell.exe",
              "pwsh.exe",
              "cmd.exe",
              "wscript.exe",
              "cscript.exe",
              "mshta.exe"
            ]
          },
          {
            "field": "parent_process_name",
            "operator": "not_in",
            "value": [
              "explorer.exe",
              "windows terminal.exe",
              "windowsterminal.exe",
              "code.exe",
              "devenv.exe",
              "services.exe",
              "taskeng.exe",
              "taskhostw.exe",
              "powershell.exe",
              "pwsh.exe",
              "cmd.exe"
            ]
          }
        ]
      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
          "process_create_time"
        ]
      },
      "mitre_attack": [
        {
          "tactic_id": "TA0002",
          "tactic_name": "Execution",
          "technique_id": "T1059",
          "technique_name": "Command and Scripting Interpreter"
        }
      ],
      "false_positives": [
        "Enterprise agents, schedulers, and application-specific automation."
      ],
      "investigation_steps": [
        "Verify the parent executable path and command line."
      ],
      "tags": [
        "process",
        "interpreter",
        "parent"
      ],
      "version": "1.0",
      "title_key": "rules.PROC-005.title",
      "description_key": "rules.PROC-005.description",
      "category_key": "rules.PROC-005.category"
    },
    {
      "id": "PROC-006",
      "title": "Many child processes in a short period",
      "description": "At least 15 new child processes were observed under the same parent PID within 30 seconds.",
      "enabled": true,
      "severity": "medium",
      "category": "Process Volume",
      "event_types": [
        "process_started"
      ],
      "conditions": {},
      "correlation": {
        "type": "count",
        "within_seconds": 30,
        "minimum_count": 15
      },
      "group_by": [
        "parent_pid"
      ],
      "deduplication": {
        "fields": [
          "parent_pid"
        ],
        "bucket_seconds": 30
      },
      "mitre_attack": [],
      "false_positives": [
        "Installers, build systems, and developer tools."
      ],
      "investigation_steps": [
        "Review the child process list and parent executable path."
      ],
      "tags": [
        "process",
        "burst"
      ],
      "version": "1.0",
      "title_key": "rules.PROC-006.title",
      "description_key": "rules.PROC-006.description",
      "category_key": "rules.PROC-006.category"
    },
    {
      "id": "PROC-007",
      "title": "New process connected to a public endpoint shortly after start",
      "description": "A newly observed process identity connected to a public remote endpoint within 30 seconds.",
      "enabled": true,
      "severity": "low",
      "category": "Process and Network Correlation",
      "event_types": [
        "process_started",
        "remote_endpoint_new"
      ],
      "conditions": {},
      "correlation": {
        "type": "followed_by",
        "within_seconds": 30,
        "ordered": true,
        "sequence": [
          {
            "event_type": "process_started"
          },
          {
            "event_type": "remote_endpoint_new",
            "conditions": {
              "field": "address_scope",
              "operator": "equals",
              "value": "public"
            }
          }
        ]
      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
          "process_create_time",
          "remote_ip",
          "remote_port"
        ]
      },
      "mitre_attack": [],
      "false_positives": [
        "Browsers, updaters, and cloud clients."
      ],
      "investigation_steps": [
        "Verify the endpoint, process path, and parent chain."
      ],
      "tags": [
        "process",
        "network"
      ],
      "version": "1.0",
      "title_key": "rules.PROC-007.title",
      "description_key": "rules.PROC-007.description",
      "category_key": "rules.PROC-007.category"
    },
    {
