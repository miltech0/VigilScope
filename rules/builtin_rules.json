{
  "format_version": 1,
  "rules": [
    {
      "id": "PROC-001",
      "title": "Office application launched a command or script interpreter",
      "description": "An Office application was observed launching a command or script interpreter.",
      "enabled": true,
      "severity": "high",
      "category": "Process Chain",
      "event_types": [
        "process_started"
      ],
      "conditions": {
        "all": [
          {
            "field": "parent_process_name",
            "operator": "in",
            "value": [
              "winword.exe",
              "excel.exe",
              "powerpnt.exe",
              "outlook.exe"
            ]
          },
          {
            "field": "process_name",
            "operator": "in",
            "value": [
              "powershell.exe",
              "pwsh.exe",
              "cmd.exe",
              "wscript.exe",
              "cscript.exe",
              "mshta.exe"
            ]
          }
        ]
      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
          "process_create_time"
        ],
        "reopen_closed": false
      },
      "mitre_attack": [
        {
          "tactic_id": "TA0002",
          "tactic_name": "Execution",
          "technique_id": "T1059",
          "technique_name": "Command and Scripting Interpreter"
        }
      ],
      "false_positives": [
        "Enterprise add-ins and legitimate Office automation."
      ],
      "investigation_steps": [
        "Verify the parent-child chain.",
        "Review the masked command line and executable path."
      ],
      "tags": [
        "process",
        "office",
        "interpreter"
      ],
      "version": "1.0",
      "title_key": "rules.PROC-001.title",
      "description_key": "rules.PROC-001.description",
      "category_key": "rules.PROC-001.category"
    },
    {
