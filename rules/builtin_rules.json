              "firefox.exe",
              "acrord32.exe",
              "acrobat.exe"
            ]
          },
          {
            "field": "process_name",
            "operator": "in",
            "value": [
              "powershell.exe",
              "pwsh.exe",
              "cmd.exe",
              "wscript.exe",
              "cscript.exe",
              "mshta.exe"
            ]
          }
        ]
      },
      "group_by": [
        "pid",
        "process_create_time"
      ],
      "deduplication": {
        "fields": [
          "pid",
